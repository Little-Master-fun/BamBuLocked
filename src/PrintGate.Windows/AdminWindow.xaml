<Window x:Class="PrintGate.Windows.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PrintGate · 工作站管理" Width="1380" Height="900" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F4F7F7" Foreground="#213D42" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AdminTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#66979B"><DockPanel Margin="18,28,18,20">
   <StackPanel DockPanel.Dock="Top"><Image Source="Assets/Online_Logo.png" Height="40" Stretch="Uniform" HorizontalAlignment="Left" Width="145"/><TextBlock Text="打印工作站管理" Foreground="#F0F7F7" Margin="7,12,0,38" FontSize="13"/>
    <TextBlock Text="工作台" Foreground="#D5E8E9" FontSize="11" Margin="16,0,0,12"/>
    <Button x:Name="RecordsNav" Style="{StaticResource Navigation}" Content="操作记录" Click="RecordsClicked"/>
    <Button x:Name="PeopleNav" Style="{StaticResource Navigation}" Content="使用人员" Click="PeopleClicked"/>
    <Button x:Name="EventsNav" Style="{StaticResource Navigation}" Content="系统事件" Click="SystemEventsClicked"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#77A3A6" CornerRadius="10" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="当前管理员" Foreground="#E0EEEE" FontSize="11"/><TextBlock x:Name="AdminIdentity" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border><Button Content="退出管理页面" Click="ExitClicked" Background="#57898E"/></StackPanel>
   <StackPanel VerticalAlignment="Bottom" Margin="12,20"><TextBlock Text="本机记录" Foreground="White"/><TextBlock Text="录像保留 7 天" Foreground="#D5E8E9" Margin="0,5,0,0" FontSize="11"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,25,28,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="工作台 / 数据管理" Style="{StaticResource Caption}"/><TextBlock x:Name="PageTitle" Text="操作记录" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="查看每一次使用，以及对应的操作录像" Foreground="#70868A" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="刷新" Click="RefreshClicked" Style="{StaticResource Secondary}" Margin="0,0,10,0"/><Button x:Name="ExportButton" Content="导出记录" Click="ExportClicked"/></StackPanel></Grid>
   <UniformGrid Grid.Row="1" x:Name="StatsPanel" Columns="4" Margin="0,0,0,18">
    <Border Style="{StaticResource Panel}" Padding="20,15" Margin="0,0,12,0"><StackPanel><TextBlock Text="使用次数" Foreground="#70868A"/><TextBlock x:Name="SessionCount" Text="—" Style="{StaticResource Number}"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Padding="20,15" Margin="0,0,12,0"><StackPanel><TextBlock Text="使用人数" Foreground="#70868A"/><TextBlock x:Name="UserCount" Text="—" Style="{StaticResource Number}"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Padding="20,15" Margin="0,0,12,0"><StackPanel><TextBlock Text="未结束 · 待确认" Foreground="#70868A"/><TextBlock x:Name="UnfinishedCount" Text="—" Style="{StaticResource Number}"/></StackPanel></Border>
    <Border Style="{StaticResource Panel}" Padding="20,15"><StackPanel><TextBlock Text="异常记录" Foreground="#70868A"/><TextBlock x:Name="AbnormalCount" Text="—" Style="{StaticResource Number}"/></StackPanel></Border>
   </UniformGrid>
   <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="18" Margin="0,0,0,18"><StackPanel>
    <WrapPanel><StackPanel x:Name="KeywordPanel" Width="220" Margin="0,0,16,8"><TextBlock Text="人员或组织" Style="{StaticResource Caption}"/><TextBox x:Name="SearchBox" MaxLength="100" ToolTip="输入姓名、学号、组织或电脑编号" KeyDown="SearchKeyDown" AutomationProperties.Name="人员或组织"/></StackPanel><StackPanel Margin="0,0,16,8"><TextBlock Text="定位使用时刻（可选）" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="FromDate" Width="138" Height="40"/><TextBox x:Name="FromTime" Width="90" Text="00:00:00" Margin="8,0,0,0" KeyDown="SearchKeyDown" AutomationProperties.Name="查询时间 时分秒"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8"><Button Content="查询记录" x:Name="QueryButton" Click="SearchClicked" Margin="0,0,8,0"/><Button Content="清除" Click="ResetClicked" Style="{StaticResource Secondary}"/></StackPanel></WrapPanel>
    <DockPanel Margin="0,4,0,0"><Button x:Name="ClearPersonButton" Content="清除人员限定" Click="ClearPersonClicked" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,4"/><TextBlock x:Name="FilterHint" Text="不选日期查看全部记录；输入一个时刻，查找当时所属的使用区间。" Foreground="#70868A" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="ValidationLabel" Foreground="#A35442" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="18,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="RecordTabs" Orientation="Horizontal"><Button x:Name="AllTab" Content="全部记录" Tag="All" Click="TabClicked" Padding="12,7"/><Button x:Name="RecordingTab" Content="录屏关联" Tag="Recorded" Click="TabClicked" Padding="12,7" Margin="4,0"/><Button x:Name="UnfinishedTab" Content="未结束" Tag="Unfinished" Click="TabClicked" Padding="12,7"/><Button x:Name="AbnormalTab" Content="异常" Tag="Abnormal" Click="TabClicked" Padding="12,7" Margin="4,0"/></StackPanel><TextBlock x:Name="TableCaption" Text="人员按使用次数排序" Visibility="Collapsed" VerticalAlignment="Center" Foreground="#70868A"/><CheckBox Grid.Column="1" x:Name="AutoRefresh" Content="自动刷新" ToolTip="每 15 秒刷新已应用的查询" IsChecked="True" VerticalAlignment="Center" Foreground="#70868A"/></Grid>
    <Grid Grid.Row="1">
     <DataGrid x:Name="SessionsGrid" MouseDoubleClick="RowDoubleClicked"><DataGrid.Columns>
      <DataGridTemplateColumn Header="使用人员" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Text="{Binding StudentId}" Foreground="#70868A" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="组织 / 电脑" Width="*" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding OrganizationLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrganizationLabel}"/><TextBlock Text="{Binding ComputerId}" Foreground="#70868A" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="使用区间" Width="184"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding StartedLabel}"/><TextBlock Text="{Binding EndedLabel, StringFormat=至 {0}}" Foreground="#70868A" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="时长" Binding="{Binding DurationLabel}" Width="90"/>
      <DataGridTemplateColumn Header="状态" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#EFF5F4" CornerRadius="5" Padding="8,5" HorizontalAlignment="Left"><TextBlock Text="{Binding ReasonLabel}" Foreground="#527873" FontSize="11"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="操作" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="记录 / 录像" Click="DetailClicked" Background="Transparent" Foreground="#427C80" Padding="0,8"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns></DataGrid>
     <DataGrid x:Name="PeopleGrid" Visibility="Collapsed" MouseDoubleClick="PersonDoubleClicked"><DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="学号" Binding="{Binding StudentId}" Width="140"/><DataGridTextColumn Header="使用次数" Binding="{Binding Uses}" Width="100"/><DataGridTextColumn Header="最近使用" Binding="{Binding LastUsed}" Width="180"/><DataGridTemplateColumn Header="操作" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="筛选记录" Click="PersonClicked" Foreground="#427C80" Background="Transparent" Padding="4,8"/><Button Content="全部历史" Click="PersonAllClicked" Foreground="#427C80" Background="Transparent" Padding="8,8"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
     <DataGrid x:Name="EventsGrid" Visibility="Collapsed"><DataGrid.Columns><DataGridTextColumn Header="发生时间" Binding="{Binding TimeLabel}" Width="190"/><DataGridTextColumn Header="事件" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="会话编号" Binding="{Binding SessionId}" Width="290"/></DataGrid.Columns></DataGrid>
     <TextBlock x:Name="EmptyLabel" Text="暂无记录" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70868A" FontSize="16"/>
    </Grid>
    <Grid Grid.Row="2" Margin="18,12,18,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultLabel" VerticalAlignment="Center" Foreground="#70868A" FontSize="12"/><StackPanel Grid.Column="1" x:Name="Pagination" Orientation="Horizontal"><Button x:Name="PreviousButton" Content="上一页" Click="PreviousClicked" Style="{StaticResource Secondary}" Padding="10,6"/><TextBlock x:Name="PageLabel" Text="1 / 1" VerticalAlignment="Center" Margin="14,0" Foreground="#70868A"/><Button x:Name="NextButton" Content="下一页" Click="NextClicked" Style="{StaticResource Secondary}" Padding="10,6"/></StackPanel></Grid>
   </Grid></Border>
   <TextBlock Grid.Row="4" x:Name="StatusLabel" Foreground="#70868A" FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
